---
import Layout from '../../layouts/Layout.astro';
import Article from '../../components/Article.astro';
import { getCollection, render } from 'astro:content';
import { ui } from '../../i18n/ui';
import { localize } from '../../i18n/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => e.id.startsWith('en/') && !e.data.draft);
  const translated = new Set(
    (await getCollection('blog', (e) => e.id.startsWith('id/') && !e.data.draft)).map((e) => e.id.replace('id/', '')),
  );
  return posts.map((post) => {
    const slug = post.id.replace('en/', '');
    return { params: { slug }, props: { post, hasTranslation: translated.has(slug) } };
  });
}

const { post, hasTranslation } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
const slug = post.id.replace('en/', '');
const breadcrumbs = [
  { name: 'Blog', href: '/blog' },
  { name: post.data.title, href: `/blog/${slug}` },
];
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.cover}
  type="article"
  publishedTime={post.data.date.toISOString()}
  breadcrumbs={breadcrumbs}
  altPath={hasTranslation ? `/id/blog/${slug}` : null}
>
  <Article
    tag={post.data.tag}
    title={post.data.title}
    dateStr={dateStr}
    cover={post.data.cover}
    dwg={post.data.dwg}
    backHref={localize('/blog', 'en')}
    backLabel={ui.en.blog.back}
  >
    <Content />
  </Article>
</Layout>
